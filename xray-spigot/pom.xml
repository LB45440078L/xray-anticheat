<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.xrayac</groupId>
    <artifactId>xray-anticheat-parent</artifactId>
    <version>1.0.3</version>
  </parent>

  <artifactId>xray-spigot</artifactId>
  <name>XRay AntiCheat :: Spigot Plugin</name>
  <description>
    Spigot adapter: event listeners, observation translation, commands, moderator GUI,
    embedded administration web server, scheduling and lifecycle wiring. This module is the
    ONLY place that touches Bukkit/Spigot types, and it uses no Paper-specific API.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.spigotmc</groupId>
      <artifactId>spigot-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.xrayac</groupId>
      <artifactId>xray-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.xrayac</groupId>
      <artifactId>xray-persistence</artifactId>
    </dependency>
    <dependency>
      <groupId>io.xrayac</groupId>
      <artifactId>xray-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>xray-anticheat-${project.version}</finalName>
    <plugins>
      <!-- Shade exists here for ONE reason: to merge this module's two sibling modules,
           xray-core and xray-persistence, into the plugin jar. They are our own code and they
           are not published to Maven Central, so plugin.yml's `libraries:` field cannot fetch
           them. Everything external is `provided` scope and therefore absent from the runtime
           artifact set, so shade has nothing else to pick up.

           What is deliberately NOT here: relocations and resource transformers. There is
           nothing left to relocate or merge now that the JDBC drivers, HikariCP and slf4j are
           no longer bundled. Adding an <artifactSet> that would swallow an external library
           re-introduces the whole problem this build was changed to solve.

           If sqlite-jdbc is ever bundled again, it must NOT be relocated: it is a JNI library
           whose native symbol names derive from its original package
           (Java_org_sqlite_core_NativeDB_...), so relocating the Java side leaves the native
           side exporting the old symbols and the driver dies with UnsatisfiedLinkError on the
           first connection - a failure no unit test can see. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <dependencies>
          <!-- Shade 3.6.2 bundles an ASM that predates Java 25 class files (major version 69)
               and cannot read them. Overriding ASM at plugin level lets us shade our own
               modules without downgrading the compiler release or the shade plugin. -->
          <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>9.10.1</version>
          </dependency>
          <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
            <version>9.10.1</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <!-- Explicit rather than implicit: bundle our own modules and nothing else. -->
              <artifactSet>
                <includes>
                  <include>io.xrayac:xray-core</include>
                  <include>io.xrayac:xray-persistence</include>
                  <include>io.xrayac:xray-web</include>
                </includes>
              </artifactSet>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
