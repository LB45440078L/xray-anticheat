<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.xrayac</groupId>
  <artifactId>xray-anticheat-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>XRay AntiCheat (parent)</name>
  <description>Statistical X-Ray / ore-visibility anti-cheat for Spigot Minecraft servers.</description>

  <!-- The project itself is proprietary. Dependencies keep their own licenses; see
       LICENSE.txt section 8 and THIRD-PARTY-NOTICES.txt. -->
  <licenses>
    <license>
      <name>Proprietary — All Rights Reserved</name>
      <url>https://github.com/LB45440078L/xray-anticheat/blob/main/LICENSE.txt</url>
      <distribution>manual</distribution>
      <comments>See LICENSE.txt in the repository root.</comments>
    </license>
  </licenses>

  <modules>
    <module>xray-core</module>
    <module>xray-persistence</module>
    <module>xray-web</module>
    <module>xray-spigot</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <!-- Dependency versions, pinned. All verified present on Maven Central /
         PaperMC as of the project's authoring date. -->
    <spigot.api.version>26.2-R0.1-SNAPSHOT</spigot.api.version>
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <mockito.version>5.24.0</mockito.version>
    <slf4j.version>2.0.20</slf4j.version>
    <hikari.version>7.1.0</hikari.version>
    <sqlite.version>3.53.4.0</sqlite.version>
    <mariadb.version>3.5.10</mariadb.version>
    <postgresql.version>42.7.13</postgresql.version>

    <compiler.plugin.version>3.16.0</compiler.plugin.version>
    <surefire.plugin.version>3.6.0</surefire.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-core</artifactId>
        <version>${mockito.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- ===========================================================================
           Libraries that the SERVER provides or that the plugin fetches at runtime.

           These are `provided` on purpose, and it is the single most important reason
           the shipped jar is small. `provided` keeps them on the compile and test
           classpaths but out of the packaged jar.

             * HikariCP, sqlite-jdbc, mariadb-java-client, postgresql — declared in
                            plugin.yml under `libraries:`, which makes the server download
                            them from Maven Central on first start and add them to this
                            plugin's classpath. That mechanism exists precisely so plugins
                            do not have to shade and relocate.
             * slf4j-api — also declared under `libraries:` now. This is a REAL change from
                            the Paper build: paper-api's own POM depends on slf4j-api, so
                            Paper servers have it on the classpath already, but spigot-api
                            does NOT and Spigot logs through java.util.logging. Relying on
                            the server for it would therefore have left the plugin with no
                            SLF4J on a Spigot server and silently dropped every log line.

           The numbers that motivated this: sqlite-jdbc alone accounted for 11.5 MB of
           the old jar because it ships native SQLite binaries for five platforms
           (Linux, Linux-Musl, Windows, Mac, FreeBSD). None of that belongs inside a
           plugin that is downloaded once and run on one machine.

           WARNING for anyone "tidying" this: these are runtime dependencies. Removing
           the `provided` scope silently puts them back inside the jar, and removing the
           `libraries:` entries from plugin.yml makes the plugin fail to load at runtime
           with NoClassDefFoundError. The two must change together, and
           tools/ci/verify_jar.sh checks both.
           =========================================================================== -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>com.zaxxer</groupId>
        <artifactId>HikariCP</artifactId>
        <version>${hikari.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.mariadb.jdbc</groupId>
        <artifactId>mariadb-java-client</artifactId>
        <version>${mariadb.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
        <scope>provided</scope>
      </dependency>

      <dependency>
        <groupId>org.spigotmc</groupId>
        <artifactId>spigot-api</artifactId>
        <version>${spigot.api.version}</version>
        <scope>provided</scope>
      </dependency>

      <dependency>
        <groupId>io.xrayac</groupId>
        <artifactId>xray-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.xrayac</groupId>
        <artifactId>xray-persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.xrayac</groupId>
        <artifactId>xray-web</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- spigot-api is not published to Maven Central, only to the SpigotMC snapshot
       repository. Snapshot metadata is re-checked on every build, so an offline build needs
       the artifact already in the local repository (`mvn dependency:get`, or one online
       build first).

       Deliberately absent: repo.papermc.io. This project compiles against the Spigot API
       only and does not depend on any Paper artifact. -->
  <repositories>
    <repository>
      <id>spigotmc-snapshots</id>
      <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
      <snapshots><enabled>true</enabled></snapshots>
      <releases><enabled>false</enabled></releases>
    </repository>
  </repositories>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.plugin.version}</version>
          <configuration>
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
        <!-- maven-shade-plugin is intentionally absent from this build. Nothing is bundled:
             the server supplies slf4j-api and plugin.yml's `libraries:` field fetches HikariCP
             and the JDBC drivers at runtime. If bundling is ever reintroduced, note that the
             shade plugin also needs its ASM dependency overridden to 9.10.1 or newer, because
             the version shade 3.6.2 carries predates Java 25 class files (major version 69). -->
      </plugins>
    </pluginManagement>
  </build>
</project>
