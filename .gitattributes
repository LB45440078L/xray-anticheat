# =====================================================================================
#  XRay AntiCheat — line-ending and diff normalisation
# =====================================================================================
#  The canonical checkout is on WSL/Linux, but the tree is mirrored to a Windows path for
#  use from an IDE. Without normalisation, one commit made from the Windows side can
#  rewrite every text file in the repository as CRLF, burying real changes in the diff.
#
#  Everything text is stored LF in the repository. Git converts on checkout only where a
#  platform genuinely needs something else, which here is nothing except Windows scripts.
# =====================================================================================

# Default: let git detect text and normalise it to LF in the repository.
* text=auto eol=lf

# Source and data, stated explicitly so the intent survives a future default change.
*.java    text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sql     text eol=lf
*.md      text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.properties text eol=lf

# Windows shells cannot run an LF-only batch file.
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binaries: never normalise, never merge, never diff.
*.jar     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary
*.db      binary
*.sqlite  binary
*.sqlite3 binary
*.zip     binary
